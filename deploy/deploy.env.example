# Copy to deploy/deploy.env (gitignored) and adjust if your setup differs.
#
# SSH_HOST is a Host alias from ~/.ssh/config, not a raw hostname — that is
# where the port (SiteGround uses 18765, not 22) and the identity file live.
SSH_HOST=siteground-ambur

# SiteGround document root. Confirm in Site Tools under Site > File Manager;
# the pattern is /home/customer/www/<domain>/public_html.
REMOTE_ROOT=/home/customer/www/theamburkitchen.nl/public_html

# Scratch directory for the upload. Removed after each successful deploy.
STAGING=/home/customer/tmp/ambur-deploy
